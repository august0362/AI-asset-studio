# Copy to .env (gitignored). Never commit real values.
# Full rules: docs/CONTRACTS.md §10, docs/DECISIONS.md D-007 and D-008.

# --- Backend ---
AAS_DATA_DIR=./data
# mock (default, no Kaggle) or kaggle (M3+)
AAS_COMPUTE_MODE=mock
AAS_BACKEND_HOST=127.0.0.1
AAS_BACKEND_PORT=8000
AAS_FRONTEND_ORIGIN=http://localhost:5173

# --- Mock compute (AAS_COMPUTE_MODE=mock only) ---
# fresh | no_session | quota_missing | telemetry_stale | telemetry_unavailable | gpu_split | quota_low
# AAS_MOCK_SCENARIO=fresh
# none | upload | submit | kernel_error | download | download_transient | status_transient | invalid_artifact | missing_manifest
# AAS_MOCK_FAILURE=none
# AAS_MOCK_QUEUE_SECONDS=1
# AAS_MOCK_RUN_SECONDS=4

# --- Compute profiles (read in kaggle mode only, M3+) ---
# One profile = one Kaggle account owned and operated by one person who has authorized its use.
# M3 enables exactly ONE profile. No rotation, pooling or automatic failover between profiles.
# Each account gets its own ID: replace DEFAULT with e.g. ALICE and list it in AAS_COMPUTE_PROFILES.
AAS_COMPUTE_PROFILES=default
# The one enabled profile. Optional if only one profile is listed; required if several are.
# Other listed profiles are shown as disabled and their credentials are never read (D-030).
AAS_ACTIVE_PROFILE=default

# Required (3 values per profile):
# USERNAME is the Kaggle account name (the part after kaggle.com/ in your profile URL), not the profile ID.
AAS_PROFILE_DEFAULT_KAGGLE_USERNAME=
AAS_PROFILE_DEFAULT_KAGGLE_API_TOKEN=
# Set to true by the account owner to confirm they authorize this use.
AAS_PROFILE_DEFAULT_AUTHORIZATION_CONFIRMED=false

# Optional:
# AAS_PROFILE_DEFAULT_DISPLAY_NAME=Owner Kaggle   # UI label; defaults to "Kaggle (<profile id>)"
# AAS_PROFILE_DEFAULT_OWNER_LABEL=project-owner   # defaults to the profile ID
# AAS_PROFILE_DEFAULT_KAGGLE_KEY=                 # only for a legacy kaggle.json key instead of an API token

# Test switch (kaggle mode): kernel_error makes every run fail on purpose inside the real notebook,
# to see how a notebook error looks in the UI. Run a CPU job with it: no GPU quota. Leave empty normally.
# AAS_KAGGLE_TEST_FAILURE=kernel_error

# --- Frontend (put in interface/frontend/.env.local) ---
# VITE_API_MODE=mock
# VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
