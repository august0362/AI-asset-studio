# Copy to .env (gitignored). Never commit real values.
# Full rules: docs/CONTRACTS.md §10, docs/DECISIONS.md D-007 and D-008.

# --- Backend ---
AAS_DATA_DIR=./data
# mock (default, no Kaggle) or kaggle (M3+)
AAS_COMPUTE_MODE=mock
AAS_BACKEND_HOST=127.0.0.1
AAS_BACKEND_PORT=8000
AAS_FRONTEND_ORIGIN=http://localhost:5173

# --- Mock compute (AAS_COMPUTE_MODE=mock only) ---
# fresh | no_session | quota_missing | telemetry_stale | telemetry_unavailable | gpu_split | quota_low
# AAS_MOCK_SCENARIO=fresh
# none | upload | submit | kernel_error | download | download_transient | status_transient | invalid_artifact | missing_manifest
# AAS_MOCK_FAILURE=none
# AAS_MOCK_QUEUE_SECONDS=1
# AAS_MOCK_RUN_SECONDS=4

# --- Compute profiles (read in kaggle mode only, M3+) ---
# One profile = one account owned and operated by one authorized person (D-040, A-02).
# Whoever runs a job explicitly selects their own account. The app cannot verify ownership.
# Multiple profiles may be enabled. Jobs run through FIFO session slots (AAS_MAX_PARALLEL_SESSIONS below).
# No rotation, pooling, summed quota, failover or resubmission on another profile.
# IDs below are generic examples, not Kaggle account names. Replace them as needed.
AAS_COMPUTE_PROFILES=profile-a,profile-b,profile-c
# AAS_ACTIVE_PROFILE is obsolete: if present it is ignored with a notice.
# Unconfirmed profiles remain listed as disabled; their credentials are never read.
# Enabled profiles require nonempty USERNAME and API_TOKEN; startup errors name variables only.
# USERNAME is the actual Kaggle account name, not the profile ID. Keep real values in .env only.
# Set each AUTHORIZATION_CONFIRMED to true only after that account owner confirms authorization.
AAS_PROFILE_PROFILE_A_KAGGLE_USERNAME=
AAS_PROFILE_PROFILE_A_KAGGLE_API_TOKEN=
AAS_PROFILE_PROFILE_A_AUTHORIZATION_CONFIRMED=false
AAS_PROFILE_PROFILE_B_KAGGLE_USERNAME=
AAS_PROFILE_PROFILE_B_KAGGLE_API_TOKEN=
AAS_PROFILE_PROFILE_B_AUTHORIZATION_CONFIRMED=false
AAS_PROFILE_PROFILE_C_KAGGLE_USERNAME=
AAS_PROFILE_PROFILE_C_KAGGLE_API_TOKEN=
AAS_PROFILE_PROFILE_C_AUTHORIZATION_CONFIRMED=false
# Kaggle sessions the app may run at the same time (D-041). A run group of two jobs is one session.
# Sessions running at once all use one profile. Kaggle's per-account concurrent-session limit is unverified (A-08).
AAS_MAX_PARALLEL_SESSIONS=1

# Optional per profile (substitute PROFILE_A / PROFILE_B / PROFILE_C):
# AAS_PROFILE_PROFILE_A_DISPLAY_NAME=Account A
# AAS_PROFILE_PROFILE_A_OWNER_LABEL=owner-a
# Auth identity and quota refresh every 5 minutes per enabled profile.
# Each profile uses its own subprocess env and an isolated empty KAGGLE_CONFIG_DIR.

# Test switch (kaggle mode): kernel_error makes every run fail on purpose inside the real notebook,
# to see how a notebook error looks in the UI. Run a CPU job with it: no GPU quota. Leave empty normally.
# AAS_KAGGLE_TEST_FAILURE=kernel_error

# --- Meshy (Image->3D, D-044, docs/CONTRACTS.md section 15) ---
# Needs a paid Meshy plan. Create the key in Meshy's developer dashboard and set a monthly credit limit on it there.
# Paste the key here only. Never in chat, logs or the repo. Empty = the Meshy profile is disabled (live mode).
AAS_MESHY_API_KEY=
# Meshy tasks that may run at the same time (at most the plan's concurrent-task limit). Separate from Kaggle sessions.
# AAS_MESHY_MAX_PARALLEL_TASKS=2
# A task still queued or running after this many seconds fails with MESHY_TIMEOUT.
# AAS_MESHY_TIMEOUT_SECONDS=3600
# Delete the task on Meshy after its outputs are stored locally (Meshy keeps files 3 days anyway).
# AAS_MESHY_DELETE_TASKS=true
# Mock mode only: fresh | low | unknown | unauthenticated, and none | submit_402 | submit_429 | submit_unknown | task_failed | download
# AAS_MOCK_MESHY_SCENARIO=fresh
# AAS_MOCK_MESHY_FAILURE=none

# --- Frontend (put in interface/frontend/.env.local) ---
# VITE_API_MODE=mock
# VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
